{
  "openapi": "3.0.3",
  "info": {
    "title": "orzFrp - system/auth API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    { "name": "auth", "description": "system auth" }
  ],
  "paths": {
    "/init/database": {
      "post": {
        "tags": ["auth"],
        "summary": "初始化数据库",
        "operationId": "InitDatabase",
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/reg/email": {
      "post": {
        "tags": ["auth"],
        "summary": "邮箱注册",
        "operationId": "RegisterByEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterByEmail" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/reg/mobile": {
      "post": {
        "tags": ["auth"],
        "summary": "手机号注册",
        "operationId": "RegisterByMobile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterByMobile" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/login/pwd": {
      "post": {
        "tags": ["auth"],
        "summary": "密码登录（邮箱/手机号）",
        "operationId": "LoginByPwd",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginByPwdReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应（data 为 LoginResp）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_LoginResp" }
              }
            }
          }
        }
      }
    },
    "/login/code": {
      "post": {
        "tags": ["auth"],
        "summary": "验证码登录（邮箱/手机号）",
        "operationId": "LoginByCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginByCodeReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应（data 为 LoginResp）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_LoginResp" }
              }
            }
          }
        }
      }
    },
    "/login/find": {
      "post": {
        "tags": ["auth"],
        "summary": "找回/重置密码（需要验证码）",
        "operationId": "FindPwd",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FindPwdReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/verify/code": {
      "post": {
        "tags": ["auth"],
        "summary": "获取短信/邮箱验证码（需要先通过图形验证码）",
        "operationId": "GetVerifyCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GetVerifyCodeReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/verify/captcha": {
      "get": {
        "tags": ["auth"],
        "summary": "获取图形验证码",
        "operationId": "GetCaptcha",
        "responses": {
          "200": {
            "description": "统一响应（data 为 GetCaptchaResp）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_GetCaptchaResp" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Resp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" }
        },
        "required": ["code", "msg"]
      },
      "RespData_LoginResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/LoginResp" }
        },
        "required": ["code", "msg", "data"]
      },
      "RespData_GetCaptchaResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/GetCaptchaResp" }
        },
        "required": ["code", "msg", "data"]
      },
      "RegisterByEmail": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "code": { "type": "string" },
          "password": { "type": "string" },
          "user_name": { "type": "string" }
        },
        "required": ["email", "code", "password", "user_name"]
      },
      "RegisterByMobile": {
        "type": "object",
        "properties": {
          "mobile": { "type": "string" },
          "code": { "type": "string" },
          "password": { "type": "string" },
          "user_name": { "type": "string" }
        },
        "required": ["mobile", "code", "password", "user_name"]
      },
      "LoginByPwdReq": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "format": "int32",
            "description": "1=邮箱 2=手机号"
          },
          "account": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["type", "account", "password"]
      },
      "LoginByCodeReq": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "format": "int32",
            "description": "1=邮箱 2=手机号"
          },
          "account": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["type", "account", "code"]
      },
      "LoginResp": {
        "type": "object",
        "properties": {
          "Token": { "type": "string" },
          "RefreshToken": { "type": "string" }
        },
        "required": ["Token", "RefreshToken"]
      },
      "GetVerifyCodeReq": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "format": "int32",
            "description": "1=邮箱验证码 2=短信验证码"
          },
          "account": { "type": "string" },
          "captcha_id": { "type": "string" },
          "captcha": { "type": "string" }
        },
        "required": ["type", "account", "captcha_id", "captcha"]
      },
      "GetCaptchaResp": {
        "type": "object",
        "properties": {
          "CaptchaId": { "type": "string" },
          "Img": { "type": "string", "description": "base64 图片" }
        },
        "required": ["CaptchaId", "Img"]
      },
      "FindPwdReq": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "format": "int32",
            "description": "1=邮箱 2=手机号"
          },
          "account": { "type": "string" },
          "code": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["type", "account", "code", "password"]
      }
    }
  }
}