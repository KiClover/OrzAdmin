{
  "openapi": "3.0.3",
  "info": {
    "title": "orzFrp - system/user API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "user",
      "description": "system user"
    }
  ],
  "paths": {
    "/init/database": {
      "post": {
        "tags": ["user"],
        "summary": "初始化数据库",
        "operationId": "InitDatabase",
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/user/create": {
      "post": {
        "tags": ["user"],
        "summary": "创建用户",
        "operationId": "CreateUser",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInfoReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应（data 为 CreateUserResp）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_CreateUserResp" }
              }
            }
          }
        }
      }
    },
    "/user/update": {
      "post": {
        "tags": ["user"],
        "summary": "更新用户",
        "operationId": "UpdateUser",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInfoReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/user/delete": {
      "post": {
        "tags": ["user"],
        "summary": "删除用户",
        "operationId": "DeleteUser",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserDeleteReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/user/list": {
      "post": {
        "tags": ["user"],
        "summary": "获取用户列表",
        "operationId": "GetUserList",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GetUserListReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应（data 为 GetUserListResp）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_GetUserListResp" }
              }
            }
          }
        }
      }
    },
    "/user/get/{id}": {
      "get": {
        "tags": ["user"],
        "summary": "根据ID获取用户",
        "operationId": "GetUserById",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应（data 为 UserInfo）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_UserInfo" }
              }
            }
          }
        }
      }
    },
    "/info/profile": {
      "post": {
        "tags": ["user"],
        "summary": "获取当前登录用户信息",
        "operationId": "GetUserProfile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "统一响应（data 为 GetUserProfileResp）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RespData_GetUserProfileResp" }
              }
            }
          }
        }
      }
    },
    "/info/update": {
      "post": {
        "tags": ["user"],
        "summary": "更新当前登录用户信息",
        "operationId": "UpdateUserInfo",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserProfileReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    },
    "/info/change-pwd": {
      "post": {
        "tags": ["user"],
        "summary": "修改当前登录用户密码",
        "operationId": "ChangePwd",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangeUserPwdReq" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resp" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "使用请求头 Authorization: Bearer <token>（代码 internal/middleware/jwt.go）"
      }
    },
    "schemas": {
      "Resp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" }
        },
        "required": ["code", "msg"]
      },

      "RespData_CreateUserResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/CreateUserResp" }
        },
        "required": ["code", "msg", "data"]
      },
      "RespData_UserInfo": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/UserInfo" }
        },
        "required": ["code", "msg", "data"]
      },
      "RespData_GetUserListResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/GetUserListResp" }
        },
        "required": ["code", "msg", "data"]
      },
      "RespData_GetUserProfileResp": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "msg": { "type": "string" },
          "data": { "$ref": "#/components/schemas/GetUserProfileResp" }
        },
        "required": ["code", "msg", "data"]
      },

      "CreateUserResp": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" }
        },
        "required": ["id"]
      },

      "UserInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "created_at": { "type": "integer", "format": "int64" },
          "updated_at": { "type": "integer", "format": "int64" },
          "status": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "password": { "type": "string" },
          "description": { "type": "string" },
          "mobile": { "type": "string" },
          "email": { "type": "string" },
          "avatar": { "type": "string" },
          "role_codes": { "type": "array", "items": { "type": "string" } },
          "role_names": { "type": "array", "items": { "type": "string" } },
          "gender": { "type": "integer", "format": "int32" }
        }
      },

      "UserInfoReq": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "password": { "type": "string" },
          "description": { "type": "string" },
          "mobile": { "type": "string" },
          "email": { "type": "string" },
          "avatar": { "type": "string" },
          "gender": { "type": "integer", "format": "int32" },
          "role_codes": { "type": "array", "items": { "type": "string" } },
          "id": { "type": "integer", "format": "int64" }
        },
        "description": "用于创建/更新/删除用户（删除时仅需要 id）"
      },

      "UserDeleteReq": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" }
        },
        "required": ["id"]
      },

      "GetUserListReq": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "format": "int32" },
          "page_size": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "mobile": { "type": "string" },
          "email": { "type": "string" },
          "status": { "type": "integer", "format": "int32" }
        }
      },
      "GetUserListResp": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "format": "int64" },
          "list": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserInfo" }
          }
        },
        "required": ["total", "list"]
      },

      "UpdateUserProfileReq": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "mobile": { "type": "string" },
          "email": { "type": "string" },
          "avatar": { "type": "string" },
          "gender": { "type": "integer", "format": "int32" }
        }
      },

      "GetUserProfileResp": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "status": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "mobile": { "type": "string" },
          "email": { "type": "string" },
          "avatar": { "type": "string" },
          "role_name": { "type": "array", "items": { "type": "string" } },
          "gender": { "type": "integer", "format": "int32" }
        }
      },

      "ChangeUserPwdReq": {
        "type": "object",
        "properties": {
          "old_password": { "type": "string" },
          "new_password": { "type": "string" }
        }
      }
    }
  }
}